{
  "name": "wonderland-plugin-wla_my_wonderland",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "build:release": "node scripts/build-release.mjs",
    "typecheck": "pnpm --dir ui run typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm --dir ui run test",
    "test:backend": "cargo build --locked --bin wonderland-wla-my-wonderland && node scripts/test-core-context.mjs",
    "check:rust": "cargo fmt --all --check && cargo clippy --locked --all-targets --all-features -- -D warnings && cargo test --locked",
    "check:bindings": "cargo run --locked --example generate_bindings --features bindings -- --check",
    "check": "pnpm run typecheck && pnpm run test && pnpm --dir ui run build",
    "package:release": "node scripts/build-release.mjs --signed"
  },
  "author": "YueFChen"
}
