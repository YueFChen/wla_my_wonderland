{
  "manifestVersion": 3,
  "id": "my_wonderland",
  "name": "我的奇域",
  "version": "0.1.4",
  "description": "查询并归档奇域作品数据。",
  "icon": "database",
  "hostCompatibility": {
    "minCoreVersion": "0.2.0",
    "maxCoreVersionExclusive": "0.3.0",
    "protocol": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    }
  },
  "platform": {
    "os": "windows",
    "architecture": "x86_64",
    "abi": "msvc"
  },
  "ui": {
    "entry": "ui/index.html",
    "bridgeCompatibility": {
      "minVersion": "1.0.0",
      "maxVersionExclusive": "2.0.0"
    },
    "integrations": [
      "theme.followHost"
    ],
    "contributions": [
      {
        "id": "main",
        "kind": "activity",
        "title": "我的奇域",
        "icon": "database",
        "defaultOrder": 300
      }
    ]
  },
  "backend": {
    "entry": "backend/wonderland-my-wonderland.exe",
    "transport": "stdio-ndjson-v1",
    "supportsServiceContext": true,
    "activation": "on_demand"
  },
  "remoteAccess": true,
  "contract": "contract.json",
  "author": "YueFChen"
}
