{
  "schemaVersion": 1,
  "$defs": {
    "empty": {
      "type": "object",
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "account_key",
        "uid",
        "region"
      ],
      "properties": {
        "account_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "additionalProperties": false
    },
    "series": {
      "type": "object",
      "required": [
        "schema_version",
        "scope",
        "updated_at",
        "fetch_count",
        "overview",
        "stages",
        "details"
      ],
      "additionalProperties": true
    },
    "account_key": {
      "type": "object",
      "required": [
        "account_key"
      ],
      "properties": {
        "account_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "methods": {
    "account_snapshot": {
      "params": {
        "$ref": "#/$defs/empty"
      },
      "result": {
        "type": "object",
        "required": [
          "status",
          "accounts",
          "last_login_failure"
        ],
        "additionalProperties": true
      },
      "timeoutMs": 5000
    },
    "series": {
      "params": {
        "type": "object",
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "$ref": "#/$defs/scope"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "oneOf": [
          {
            "$ref": "#/$defs/series"
          },
          {
            "type": "null"
          }
        ]
      },
      "timeoutMs": 5000
    },
    "collect": {
      "params": {
        "type": "object",
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "$ref": "#/$defs/scope"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "$ref": "#/$defs/series"
      },
      "timeoutMs": 3600000
    },
    "account_login": {
      "params": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "cn",
              "global"
            ],
            "default": "cn"
          }
        },
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "required": [
          "status",
          "accounts",
          "last_login_failure"
        ],
        "additionalProperties": true
      },
      "localOnly": true
    },
    "account_login_cancel": {
      "params": {
        "$ref": "#/$defs/empty"
      },
      "result": {
        "type": "object"
      },
      "localOnly": true
    },
    "account_sync": {
      "params": {
        "$ref": "#/$defs/account_key"
      },
      "result": {
        "type": "object"
      },
      "localOnly": true
    },
    "account_switch": {
      "params": {
        "$ref": "#/$defs/account_key"
      },
      "result": {
        "type": "object"
      },
      "localOnly": true
    },
    "account_remove": {
      "params": {
        "$ref": "#/$defs/account_key"
      },
      "result": {
        "type": "object"
      },
      "localOnly": true
    },
    "export_history": {
      "params": {
        "$ref": "#/$defs/empty"
      },
      "result": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "state",
              "name",
              "size",
              "path"
            ],
            "properties": {
              "kind": {
                "const": "local"
              },
              "state": {
                "const": "saved"
              },
              "name": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "state",
              "name",
              "size",
              "downloadId"
            ],
            "properties": {
              "kind": {
                "const": "remote"
              },
              "state": {
                "const": "ready"
              },
              "name": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "downloadId": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "import_history": {
      "params": {
        "type": "object",
        "required": [
          "confirmed"
        ],
        "properties": {
          "confirmed": {
            "const": true
          }
        },
        "additionalProperties": false
      },
      "result": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "created",
              "merged",
              "unchanged"
            ],
            "properties": {
              "created": {
                "type": "integer",
                "minimum": 0
              },
              "merged": {
                "type": "integer",
                "minimum": 0
              },
              "unchanged": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "events": {
    "history.changed": {
      "payload": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "account.changed": {
      "payload": {
        "type": "object"
      }
    }
  }
}
